@article{tang2026satellite,
  abbr={UFUG},
  title={A Satellite-Based Assessment of Alder Pollen Exposure across 51 Cities in Bavaria, Germany},
  author={Tang, Zirui and Mu, Yang and Gonzalez-Alonso, Monica and Li, Qingyu},
  abstract={We developed a satellite-based framework to assess alder pollen exposure across 51 cities in Bavaria, integrating remote sensing land cover with pollen monitoring data. Our analysis reveals spatial patterns of pollen exposure linked to urban vegetation and supports allergy-aware urban greening and public health planning.},
