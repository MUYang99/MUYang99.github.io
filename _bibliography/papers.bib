  url={https://www.sciencedirect.com/science/article/pii/S1569843225001694},
  html={https://www.sciencedirect.com/science/article/pii/S1569843225001694},
  selected={true},
  preview={tsm.png},
  bibtex_show={true},
  code={https://github.com/MUYang99/Pytorch_Tree-Species-Mapping}
}

@inproceedings{mu2025mpts,
  abbr={AAAI},
  title={MPTSNet: Integrating Multiscale Periodic Local Patterns and Global Dependencies for Multivariate Time Series Classification},
