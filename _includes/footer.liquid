{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
  <br>
  <div class="web-counter">
    <!-- Web Counter -->
    <img src="https://hitwebcounter.com/counter/counter.php?page=11750068&style=0006&nbdigits=6&type=page&initCount=0" title="Total Website Hits" alt="Web Hits" border="0"/>
    <span class="counter-label">page views</span>
    <span class="counter-separator">|</span>
    <img src="https://hitwebcounter.com/counter/counter.php?page=11750069&style=0006&nbdigits=6&type=ip&initCount=0" title="Unique Visitors" alt="Unique Visitors" border="0"/>
    <span class="counter-label">unique visitors</span>
    <br>
    <small style="opacity: 0.7;">since March 2025</small>
  </div>
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
