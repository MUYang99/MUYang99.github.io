<div class="news">
  {% if site.news != blank %}
    {% assign news = site.news | reverse %}
    {% assign news_size = news | size %}
    {% assign visible_limit = 5 %}
    {% if include.limit and page.announcements.limit %}
      {% assign visible_limit = page.announcements.limit %}
    {% endif %}

    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% for item in news limit: visible_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>

    {% if news_size > visible_limit %}
      {% assign older_count = news_size | minus: visible_limit %}
      <details class="news-archive">
        <summary class="news-archive-toggle">Show older news ({{ older_count }})</summary>
        <div class="table-responsive">
          <table class="table table-sm table-borderless">
            {% for item in news offset: visible_limit %}
              <tr>
                <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
                <td>
                  {% if item.inline %}
                    {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                  {% else %}
                    <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </table>
        </div>
      </details>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
